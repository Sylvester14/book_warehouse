{% extends 'base.html.twig' %}

{% block title %}Book Warehouse{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="/styles/main.css">{% endblock %}

{% block body %}
    <div class="warehouse-container">
        <div class="warehouse-container__filters">
            {% include "book/_filter_block.html.twig" with {
                'title': 'Список книг',
                'id': 'books-select',
                'items': books
            } %}

            {% include "book/_filter_block.html.twig" with {
                'title': 'Список авторов',
                'id': 'authors-select',
                'items': authors
            } %}

            {% include "book/_filter_block.html.twig" with {
                'title': 'Список магазинов',
                'id': 'stores-select',
                'items': stores
            } %}
        </div>

        <div class="showcase-section">
            <h2>Витрина <span style="display: none" id="timer">⏳</span></h2>
            <div id="showcase-container" class="showcase-grid">
            </div>
            <div id="empty-message" class="empty-message">Витрина пуста</div>
        </div>
    </div>
    <script src="scripts/main.js"></script>
{% endblock %}

